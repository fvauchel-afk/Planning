NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias accepté (ancienne convention) :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (Dashboard Supabase → Project Settings → API). Obligatoire
# après le script 015_auth_pin.sql, sinon l’app ne peut plus lire/écrire.
SUPABASE_SERVICE_ROLE_KEY=
# Alias accepté (nouvelles clés) :
# SUPABASE_SECRET_KEY=

# Optionnel : secret de signature des sessions PIN
# AUTH_SECRET=

# OneDrive / Microsoft Graph (côté serveur uniquement, sans NEXT_PUBLIC_)
ONEDRIVE_CLIENT_ID=
# Compte personnel Microsoft : consumers (un GUID de tenant d’entreprise n’est pas requis)
ONEDRIVE_TENANT_ID=consumers
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/onedrive/callback
ONEDRIVE_ROOT_SHARE_URL=

# Cron Vercel (lundi 3h UTC) + appels manuels protégés
BACKUP_CRON_SECRET=
# Sur Vercel, définissez aussi CRON_SECRET avec la même valeur :
# Vercel envoie automatiquement Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
