NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias accepté (ancienne convention) :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (Dashboard Supabase → Project Settings → API). Obligatoire
# après le script 015_auth_pin.sql, sinon l’app ne peut plus lire/écrire.
SUPABASE_SERVICE_ROLE_KEY=
# Alias accepté (nouvelles clés) :
# SUPABASE_SECRET_KEY=

# Optionnel : secret de signature des sessions PIN
# AUTH_SECRET=

# OneDrive / Microsoft Graph (côté serveur uniquement, sans NEXT_PUBLIC_)
ONEDRIVE_CLIENT_ID=
# Compte personnel Microsoft : consumers (un GUID de tenant d’entreprise n’est pas requis)
ONEDRIVE_TENANT_ID=consumers
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:3000/api/onedrive/callback
ONEDRIVE_ROOT_SHARE_URL=

# Cron Vercel : tous les jours à 3h UTC (vers 4h/5h en France).
# Vercel envoie Authorization: Bearer $CRON_SECRET — définissez CRON_SECRET
# et BACKUP_CRON_SECRET (même valeur) dans les variables du projet Vercel.
BACKUP_CRON_SECRET=
CRON_SECRET=

# Optionnel : notification de déploiement Vercel (Settings → Deployments →
# Notifications) vers https://VOTRE-DOMAINE/api/backup/run?reason=deploy
# avec l’en-tête Authorization: Bearer <CRON_SECRET>.
# Sans cette notification, la copie au déploiement part dès le premier
# chargement de la nouvelle version en production.

# Destinataires des e-mails de commandes (Alexis / Mika). Par défaut :
# f.vauchel@hotmail.com — le compte OneDrive connecté est l’expéditeur.
# COMMANDE_NOTIFY_EMAILS=f.vauchel@hotmail.com

# Web Push (notifications commandes, app fermée). À copier aussi sur Vercel.
# Sujet : mailto: de la boîte atelier.
VAPID_SUBJECT=mailto:f.vauchel@hotmail.com
VAPID_PUBLIC_KEY=BIQ8HsSpjG0Cq42JK_i7wSZvTxhMjqLR-zSEjsx51jsNLZdElBf7VcAjDD5MGoGiUzxDKUGyfuxdNQ4NU6hX4WQ
VAPID_PRIVATE_KEY=dkdUDLdNA_itb0aMS4jxSHPmtfN_JVYXd490zb1rjjI
